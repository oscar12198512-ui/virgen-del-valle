rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. COMANDAS Y PEDIDOS (orders)
    // Permite que clientes por QR, mesoneros, capitanes y administración creen, consulten y actualicen pedidos en tiempo real
    match /orders/{orderId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }

    // 2. ESTADO GLOBAL DEL RESTAURANTE (app_state)
    // Menú, tasa BCV del día, toldos, cuentas de Pago Móvil / Zelle, participantes del sorteo
    match /app_state/{docId} {
      allow read, write: if true;
    }

    // 3. USUARIOS Y PERSONAL (app_users)
    // Roles (admin, mesonero, cocina, cliente, excursión) y accesos
    match /app_users/{userId} {
      allow read, write: if true;
    }

    // 4. CIERRES DE CAJA Y ARQUEO DE MESONEROS (closings)
    match /waiters_closings/{closingId} {
      allow read, write: if true;
    }

    // Regla global de contingencia para cualquier otra colección del sistema
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
