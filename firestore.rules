rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // FUNCIONES DE SEGURIDAD Y CONTROL DE ACCESO BASADO EN ROLES (RBAC)
    // =========================================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/app_users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/app_users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'admin') ||
        (hasUserDoc() && getUserData().role == 'admin')
      );
    }

    function isWaiter() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'waiter') ||
        (hasUserDoc() && getUserData().role == 'waiter')
      );
    }

    function isKitchen() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role in ['kitchen', 'cocina', 'cocinero', 'chef']) ||
        (hasUserDoc() && getUserData().role in ['kitchen', 'cocina', 'cocinero', 'chef'])
      );
    }

    function isExcursion() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'excursion') ||
        (hasUserDoc() && getUserData().role == 'excursion')
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        isAdmin() ||
        isWaiter() ||
        isKitchen() ||
        isExcursion()
      );
    }

    // =========================================================================
    // 1. ESTADO GLOBAL OPERATIVO (app_state)
    // Menú, tasa BCV, toldos y carta digital
    // =========================================================================
    match /app_state/{docId} {
      // Lectura pública necesaria para visualizar carta digital, menú y disponibilidad
      allow read: if true;

      // Modificación estrictamente reservada al Dueño / Administrador
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // 2. CATÁLOGO INDIVIDUAL: PLATOS, TOLDOS Y PAQUETES DE EXCURSIÓN
    // =========================================================================
    match /menu_items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /spots/{spotId} {
      allow read: if true;
      // Creación y eliminación de toldos reservada exclusivamente al Dueño / Admin
      allow create, delete: if isAdmin();
      // Actualización operativa: Dueño o mesoneros asignando disponibilidad
      allow update: if isAdmin() || (
        isWaiter() &&
        request.resource.data.id == resource.data.id
      );
    }

    match /excursions/{excursionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // 3. COMANDAS Y PEDIDOS EN TIEMPO REAL (orders)
    // Privacidad estricta: comensales solo leen sus propios pedidos.
    // Cocina solo actualiza estados operativos; Mesoneros no alteran precios ni verifican pagos.
    // =========================================================================
    match /orders/{orderId} {
      // Lectura: Administrador y cocina ven todas; mesoneros ven órdenes de toldos/playa;
      // personal de excursiones ve únicamente las de sus propios servicios;
      // y clientes únicamente sus propios pedidos.
      allow read: if isAdmin() || isKitchen() || (
        isWaiter() && (!('origin' in resource.data) || resource.data.origin != 'excursion')
      ) || (
        isExcursion() && resource.data.origin == 'excursion'
      ) || (
        isAuthenticated() && (
          (resource.data.clientUserId != null && resource.data.clientUserId == request.auth.uid) ||
          (resource.data.customerId != null && resource.data.customerId == request.auth.uid)
        )
      );

      // Creación: Exige campos obligatorios, importes válidos, cantidades permitidas
      // y estados iniciales válidos para cada rol.
      allow create: if (
        request.resource.data.keys().hasAll(['id', 'spotId', 'items', 'totalUsd', 'status', 'createdAt', 'origin']) &&
        request.resource.data.status in ['pending', 'in_fire'] &&
        request.resource.data.totalUsd is number &&
        request.resource.data.totalUsd >= 0 &&
        (!('subtotalUsd' in request.resource.data) || (request.resource.data.subtotalUsd is number && request.resource.data.subtotalUsd >= 0)) &&
        (!('totalBs' in request.resource.data) || (request.resource.data.totalBs is number && request.resource.data.totalBs >= 0)) &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 50 &&
        (!('isSettled' in request.resource.data) || request.resource.data.isSettled == false) &&
        (
          isAdmin() ||
          (isWaiter() && request.resource.data.origin in ['waiter_pos', 'client_qr'] && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus in ['pending', 'cash_waiter', 'pending_verification'])) ||
          (isExcursion() && request.resource.data.origin == 'excursion' && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus in ['pending', 'pending_verification'])) ||
          (isAuthenticated() && request.resource.data.origin == 'client_qr' && (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus in ['pending', 'pending_verification']) && (request.resource.data.clientUserId == request.auth.uid || request.resource.data.customerId == request.auth.uid))
        )
      );

      // Actualización: Permisos estrictos por rol con listas explícitas de campos modificables.
      // Nadie que no sea Dueño / Admin puede alterar precios, liquidar o aprobar pagos.
      allow update: if isAdmin() || (
        // COCINA: Solo puede actualizar estados operativos y tiempos de cocción;
        // NO puede modificar precios, totales, método de pago ni liquidación.
        isKitchen() &&
        (!('isSettled' in resource.data) || resource.data.isSettled != true) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'items', 'kitchenStep', 'updatedAt', 'prepTimerSeconds',
          'readyAt', 'prepDurationMinutes', 'elapsedSeconds'
        ]) &&
        request.resource.data.status in ['pending', 'in_fire', 'plated', 'ready_pass', 'delivered', 'cancelled']
      ) || (
        // MESONEROS: Gestionan flujo de toldos/playa; no pueden modificar comandas de excursión,
        // no pueden alterar totales ni ítems, y no pueden auto-marcar órdenes como verificadas o liquidadas.
        isWaiter() &&
        (!('isSettled' in resource.data) || resource.data.isSettled != true) &&
        (!('origin' in resource.data) || resource.data.origin != 'excursion') &&
        request.resource.data.totalUsd == resource.data.totalUsd &&
        (!('subtotalUsd' in resource.data) || request.resource.data.subtotalUsd == resource.data.subtotalUsd) &&
        request.resource.data.items == resource.data.items &&
        (!('isSettled' in request.resource.data) || request.resource.data.isSettled == resource.data.isSettled) &&
        (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus in ['pending', 'cash_waiter', 'pending_verification'])
      ) || (
        // EXCURSIONES: Gestionan únicamente pedidos de excursión; no pueden liquidar ni auto-aprobar pagos.
        isExcursion() &&
        resource.data.origin == 'excursion' &&
        (!('isSettled' in resource.data) || resource.data.isSettled != true) &&
        (!('isSettled' in request.resource.data) || request.resource.data.isSettled == resource.data.isSettled) &&
        (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus in ['pending', 'pending_verification'])
      ) || (
        // CLIENTES: Solo pueden adjuntar comprobante de pago ('pending_verification') sin alterar totales ni ítems.
        isAuthenticated() &&
        (resource.data.clientUserId == request.auth.uid || resource.data.customerId == request.auth.uid) &&
        (!('isSettled' in resource.data) || resource.data.isSettled != true) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.spotId == resource.data.spotId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.totalUsd == resource.data.totalUsd &&
        request.resource.data.items == resource.data.items &&
        (!('isSettled' in request.resource.data) || request.resource.data.isSettled == resource.data.isSettled) &&
        (
          (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == resource.data.paymentStatus) ||
          (resource.data.paymentStatus != 'verified' && request.resource.data.paymentStatus == 'pending_verification')
        )
      );

      // Eliminación: Estrictamente restringida a administradores
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 4. USUARIOS Y PERSONAL (app_users)
    // Previene escalación de privilegios y falsificación de roles
    // =========================================================================
    match /app_users/{userId} {
      // Lectura: Staff puede ver listado de personal; Clientes solo consultan su propio perfil
      // o documentos asociados a su correo verificado de autenticación
      allow read: if isStaff() || (
        isAuthenticated() && (
          request.auth.uid == userId ||
          (resource.data.email != null && resource.data.email == request.auth.token.email)
        )
      );

      // Registro: Solo admin puede crear staff; Nuevos usuarios auto-registrados quedan fijados en rol 'client' activo
      allow create: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == userId && 
        (!('role' in request.resource.data) || request.resource.data.role == 'client') &&
        (!('status' in request.resource.data) || request.resource.data.status == 'active')
      );

      // Edición: Solo admin puede modificar roles o estados ajenos; Usuarios normales solo actualizan sus propios datos sin alterar rol ni status
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == userId && 
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status
      );

      // Eliminación: Exclusiva para administradores
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 5. CIERRES DE CAJA Y ARQUEO DE MESONEROS (waiters_closings)
    // =========================================================================
    match /waiters_closings/{closingId} {
      // Lectura: Administradores pueden auditar todos los cierres.
      // Los mesoneros ÚNICAMENTE pueden consultar sus propios cierres de caja.
      // Cocina, excursiones y clientes no tienen acceso.
      allow read: if isAdmin() || (
        isWaiter() && resource.data.waiterId == request.auth.uid
      );

      // Creación: Administrador puede crear cualquier cierre.
      // Mesoneros solo pueden registrar su propio cierre en estado pendiente,
      // sin auto-declarar liquidación, firmas de paz y salvo ni sellos de dueño.
      allow create: if isAdmin() || (
        isWaiter() &&
        request.resource.data.waiterId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        (!('settledAt' in request.resource.data) || request.resource.data.settledAt == null) &&
        (!('settledByOwner' in request.resource.data) || request.resource.data.settledByOwner == null) &&
        (!('pazYSalvoHash' in request.resource.data) || request.resource.data.pazYSalvoHash == null) &&
        (!('pazYSalvoNumber' in request.resource.data) || request.resource.data.pazYSalvoNumber == null)
      );

      // Actualización:
      // Administrador puede liquidar, ajustar deducciones o emitir paz y salvo.
      // Mesoneros solo pueden actualizar su propio cierre si aún NO está liquidado,
      // sin alterar waiterId, sin marcarse como liquidados y sin manipular deducciones ni hash del dueño.
      allow update: if isAdmin() || (
        isWaiter() &&
        resource.data.waiterId == request.auth.uid &&
        request.resource.data.waiterId == request.auth.uid &&
        resource.data.status != 'settled' &&
        request.resource.data.status != 'settled' &&
        (!('settledAt' in request.resource.data) || request.resource.data.settledAt == resource.data.settledAt) &&
        (!('settledByOwner' in request.resource.data) || request.resource.data.settledByOwner == resource.data.settledByOwner) &&
        (!('pazYSalvoHash' in request.resource.data) || request.resource.data.pazYSalvoHash == resource.data.pazYSalvoHash) &&
        (!('pazYSalvoNumber' in request.resource.data) || request.resource.data.pazYSalvoNumber == resource.data.pazYSalvoNumber) &&
        (!('pagoMovilDeductedUsd' in request.resource.data) || request.resource.data.pagoMovilDeductedUsd == resource.data.pagoMovilDeductedUsd) &&
        (!('internationalDeductedUsd' in request.resource.data) || request.resource.data.internationalDeductedUsd == resource.data.internationalDeductedUsd)
      );

      // Eliminación: Estrictamente restringida a administradores
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 6. LIQUIDACIÓN DE EXCURSIONES Y LANCHAS (excursion_settlements)
    // =========================================================================
    match /excursion_settlements/{settlementId} {
      // Lectura: Administrador audita todas; guía/capitán consulta las de su servicio
      allow read: if isAdmin() || (
        isExcursion() && (
          resource.data.guideId == request.auth.uid ||
          !('guideId' in resource.data)
        )
      );

      // Creación: Administrador o personal de excursión registrando reporte pendiente
      allow create: if isAdmin() || (
        isExcursion() &&
        request.resource.data.status == 'pending' &&
        (!('settledAt' in request.resource.data) || request.resource.data.settledAt == null) &&
        (!('settledByAdmin' in request.resource.data) || request.resource.data.settledByAdmin == null)
      );

      // Actualización: Admin liquida; personal solo actualiza mientras esté pendiente
      allow update: if isAdmin() || (
        isExcursion() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'pending' &&
        (!('settledAt' in request.resource.data) || request.resource.data.settledAt == resource.data.settledAt) &&
        (!('settledByAdmin' in request.resource.data) || request.resource.data.settledByAdmin == resource.data.settledByAdmin)
      );

      // Eliminación: Exclusiva para administradores
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 7. CONFIGURACIONES FINANCIERAS Y DEL SISTEMA (settings)
    // =========================================================================
    match /settings/{settingId} {
      // Lectura: Administradores y mesoneros que requieren consultar tasas y cuentas
      allow read: if isAdmin() || isWaiter();
      // Escritura: Estrictamente restringida al Administrador / Dueño
      allow write: if isAdmin();
    }

    // Denegación por defecto para cualquier otra ruta no especificada
  }
}
