# --- API / producción -------------------------------------------------------
# Conexion PostgreSQL. Acepta dos formas (configurar solo una):
#   1) DATABASE_URL completa (lo inyecta Render con fromDatabase.connectionString)
#   2) PGHOST + PGPORT + PGDATABASE + PGUSER + PGPASSWORD
DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE?sslmode=require"
PGHOST=""
PGPORT="5432"
PGDATABASE="virgen_del_valle"
PGUSER=""
PGPASSWORD=""
# "require" fuerza TLS (util solo si el servidor lo exige; la red interna de Render no lo necesita).
PGSSLMODE=""

DATABASE_POOL_MAX="5"
PORT="10000"
NODE_ENV="production"

# URLs publicas
APP_URL="https://virgen-del-valle-web.onrender.com"
CORS_ORIGIN="https://virgen-del-valle-web.onrender.com,http://localhost:3000,http://localhost:5173,https://localhost"
# URL publica de la API: la usa el frontend (Vite la incrusta en el build).
VITE_API_URL="https://virgen-del-valle-api.onrender.com"

# --- Sesiones ---------------------------------------------------------------
SESSION_TTL_HOURS="24"

# --- Cuenta de dueño inicial ------------------------------------------------
# Se crea una sola vez, en el primer arranque. La clave se guarda con bcrypt.
OWNER_NAME="Emmanuel Mejías"
OWNER_PHONE="04127939128"
OWNER_EMAIL="Emmanuelmejias2616@gmail.com"
OWNER_INITIAL_PASSWORD="DEFINE_ESTA_CLAVE_EN_RENDER"

# --- Recuperación de contraseña (opcional) ----------------------------------
# Sin SMTP configurado el enlace de recuperación queda registrado en los logs
# del servicio, nunca se acepta ninguna clave por defecto.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# --- Lectura de comprobantes con Gemini (opcional, solo servidor) ----------
# La clave se usa desde la API. NUNCA la expongas como VITE_*: viajaria al APK.
GEMINI_API_KEY=""

# --- Firebase (Firestore & Authentication) -----------------------------------
# Configura estas variables desde tu consola de Firebase (Configuración del proyecto -> Aplicaciones web)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="tu-proyecto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="tu-proyecto"
VITE_FIREBASE_STORAGE_BUCKET="tu-proyecto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# --- Desarrollo local -------------------------------------------------------
VITE_API_URL="http://localhost:10000"